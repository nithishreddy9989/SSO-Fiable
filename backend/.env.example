# Microsoft Entra ID (Azure AD) App Registration Credentials
AZURE_CLIENT_ID=your-entra-client-id-here
AZURE_Organizations_ID=common
AZURE_CLIENT_SECRET=your-entra-client-secret-optional-for-backend

# Authority settings
# Single Organizations: https://login.microsoftonline.com/<your-Organizations-id>
# Multi-Organizations: https://login.microsoftonline.com/common
# Work/School Accounts: https://login.microsoftonline.com/organizations
AZURE_AUTHORITY=https://login.microsoftonline.com/common

# Redirect URIs
REDIRECT_URI=http://localhost:5173

# Application Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MOCK_AUTH_MODE=true
